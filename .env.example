# ─────────────────────────────────────────────────────────────
# Margin — environment configuration
# Copy to `.env` and fill in what you need. Nothing here is required
# to boot the app locally: missing AI keys put the app into a clearly
# labelled "offline" mode where retrieval still works but no model runs.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3001
# Public URL of the app (used for cookies / CORS in production)
APP_URL=http://localhost:5173

# Database. Leave unset to use the embedded Postgres (PGlite) stored in ./data/db.
# For a deployed, multi-device setup use a hosted Postgres with pgvector (Neon, Supabase, RDS…):
# DATABASE_URL=postgres://user:password@host:5432/margin
PGLITE_DIR=./data/db

# Where uploaded files are stored (keep this on a persistent, backed-up volume in production)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=30

# Account creation: "first-user" (only the very first account can register — the default
# for a personal app), "open", or "closed".
REGISTRATION_MODE=first-user

# ── AI: Anthropic Claude (chat, document analysis, memory, writing profile) ──
# Get a key at https://platform.claude.com/ → API keys
ANTHROPIC_API_KEY=
AI_CHAT_MODEL=claude-opus-5-5
# Effort for chat answers: low | medium | high | xhigh | max
AI_CHAT_EFFORT=medium
# Model used for background work (memory extraction, document classification, writing analysis).
# Set to claude-haiku-5-5 to cut background costs substantially.
AI_BACKGROUND_MODEL=claude-opus-5-5
AI_BACKGROUND_EFFORT=low

# ── Embeddings (semantic search) ──
# local  = runs on your machine via transformers.js (free, private; downloads a ~30 MB model once)
# voyage = Voyage AI API (higher quality, needs VOYAGE_API_KEY)
# none   = keyword search only
EMBEDDINGS_PROVIDER=local
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# ── Speech-to-text (voice dictation) ──
# Any OpenAI-compatible /audio/transcriptions endpoint works (OpenAI, Groq, a local whisper server…).
# If unset, the app falls back to the browser's built-in speech recognition where available.
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
